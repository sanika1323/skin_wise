PORT=4000
# Get an API key from https://yce.makeupar.com/api-console/en/api-keys/
# Server-side only. Never put this in a VITE_* variable.
YOUCAM_API_KEY=replace_with_your_real_youcam_api_key
# Optional: YouCam API server (verify against the current API docs)
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# Optional: comma-separated allowed origins for a deployed frontend (defaults to any origin)
# CORS_ORIGIN=https://your-frontend.vercel.app
# Optional: where JSON data is stored (use a persistent disk in production)
# DATA_DIR=/var/data/skinwise
# Optional: hours to cache product prices/images on disk (default 6)
# CACHE_TTL_HOURS=6
# Optional: price-comparison source (default https://pricee.com)
# PRICEE_BASE_URL=https://pricee.com
